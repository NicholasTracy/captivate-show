{
  "name": "captivate-show",
  "version": "0.1.0",
  "description": "Holiday show sequencer",
  "main": "dist-electron/main.js",
  "scripts": {
    "fix-encoding": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fix-encoding.ps1",
    "predev": "npm run fix-encoding",
    "pretypecheck": "npm run fix-encoding",
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "fast-xml-parser": "^5.2.5",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "multicast-dns": "^7.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^13.0.0",
    "styled-components": "^5.3.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/styled-components": "^5.1.34",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}